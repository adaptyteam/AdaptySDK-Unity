<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The current package compiled into its own assembly, so its public surface can be read by
    reflection and compared with the next package's. Both declare the same type names in the same
    namespace, so they can only be compared as separate assemblies, loaded for metadata only.

    Kept in its own directory: two projects sharing one folder also share obj/, and their
    restore output overwrites each other.

    Not a test project - it exists to be built and then read from disk.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>AdaptySDK.CurrentSurface</AssemblyName>
    <NoWarn>CS0169;CS0649;CS0414;CS0067;CS0618</NoWarn>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <SdkRuntime>$(MSBuildThisFileDirectory)../../../Packages/com.adapty.unity-sdk/Runtime</SdkRuntime>
    <GoldenTests>$(MSBuildThisFileDirectory)../../AdaptySDK.GoldenTests</GoldenTests>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AdaptyPlatform)' != ''">
    <DefineConstants>$(DefineConstants);$(AdaptyPlatform)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(SdkRuntime)/*.cs" LinkBase="Sdk" />
    <Compile Include="$(SdkRuntime)/Models/*.cs" LinkBase="Sdk/Models" />
    <Compile Include="$(SdkRuntime)/JSON/*.cs" LinkBase="Sdk/JSON" />
    <Compile Include="$(SdkRuntime)/Plugins/AdaptyNoop.cs" LinkBase="Sdk/Plugins" />
    <Compile Include="$(SdkRuntime)/Plugins/iOS/*.cs" LinkBase="Sdk/Plugins/iOS" />
    <Compile Include="$(SdkRuntime)/Plugins/Android/*.cs" LinkBase="Sdk/Plugins/Android" />
    <Compile Include="$(GoldenTests)/UnityStubs.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
